# ==============================================================================
# ANHVL WHATSAPP PATIENT ENGAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION
# Developed by Plan D Media for Neotia Bhagirathi / ANHVL
# ==============================================================================
# NEVER commit real production secrets to source control.

# Application Environment: development | staging | production
APP_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Operating Mode: true = Isolated Synthetic Demo Mode | false = Production Mode
# Production Mode requires verified Meta WhatsApp, HIS, and Altruist credentials
# and will NEVER silently fall back to simulated patient messaging.
DEMO_MODE=true

# PostgreSQL Database Connection (UTC timestamps enforced)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/anhvl_engagement?schema=public"

# Redis / BullMQ Background Queue Connection
REDIS_URL="redis://127.0.0.1:6379"

# Authentication & Security Secrets
JWT_SECRET="replace-with-strong-64-byte-production-jwt-secret-key"
JWT_REFRESH_SECRET="replace-with-strong-64-byte-production-refresh-secret-key"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Meta WhatsApp Business Cloud API Configuration (Required for Production Mode)
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_VERIFY_TOKEN="anhvl-meta-webhook-verify-token"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"

# Hospital Information System (HIS) Integration Configuration
HIS_API_BASE_URL=""
HIS_API_AUTH=""
HIS_WEBHOOK_SECRET="anhvl-his-webhook-secret"
HIS_SFTP_IMPORT_DIR="./data/sftp-inbox"

# Altruist Call-Centre Integration Configuration
ALTRUIST_API_BASE_URL=""
ALTRUIST_API_AUTH=""
ALTRUIST_HANDOFF_MODE="WORKLIST_CSV"

