{
  "name": "anhvl-patient-engagement",
  "version": "1.0.0",
  "private": true,
  "description": "ANHVL WhatsApp Patient Engagement Platform — Developed by Plan D Media",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "start:api": "npm --workspace=apps/api run start",
    "db:generate": "npx prisma generate",
    "db:migrate": "node infrastructure/scripts/run-migrations.mjs",
    "db:seed": "node prisma/seed/seed.mjs",
    "test": "npm --workspace=apps/api run test",
    "test:e2e": "npm --workspace=apps/api run test:e2e"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.6",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}